{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Contract",
  "type": "object",
  "required": ["id", "name", "level", "mission", "responsibilities", "inputs", "outputs", "validationCriteria", "prohibitions", "escalade", "deliverables"],
  "properties": {
    "id": { "type": "string", "pattern": "^akoris_(core|expert)_[a-z_]+$" },
    "name": { "type": "string" },
    "level": { "type": "string", "enum": ["Core", "Expert"] },
    "domain": { "type": "string" },
    "mission": { "type": "string" },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "validationCriteria": { "type": "array", "items": { "type": "string" } },
    "prohibitions": { "type": "array", "items": { "type": "string" } },
    "escalade": { "type": "string" },
    "deliverables": { "type": "array", "items": { "type": "string" } }
  }
}
