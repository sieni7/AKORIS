    {
      "id": "validate_criteria",
      "name": "Valider les critères",
      "description": "Valider les critères des gates",
      "type": "can"
    },
    {
      "id": "enforce_quality",
      "name": "Imposer la qualité",
      "description": "Imposer les règles de qualité",
      "type": "can"
    }
  ]
