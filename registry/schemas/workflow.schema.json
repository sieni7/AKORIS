{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://akoris.dev/schemas/workflow.schema.json",
  "title": "Workflow",
  "description": "Schema de validation pour les fichiers de workflow",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nom du workflow"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Version semantique du workflow"
    },
    "description": {
      "type": "string",
      "description": "Description du workflow"
    },
    "type": {
      "type": "string",
      "enum": ["institutional", "mobile", "api", "library", "cli", "custom"],
      "description": "Type de projet associe"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de la phase"
          },
          "name": {
            "type": "string",
            "description": "Nom de la phase"
          },
          "description": {
            "type": "string",
            "description": "Description de la phase"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "description": "Ordre d'execution de la phase"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "optional": { "type": "boolean", "default": false },
                "dependencies": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "outputs": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["id", "name"]
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "criteria": {
                "type": "array",
                "items": { "type": "string" }
              },
              "human_required": { "type": "boolean", "default": false }
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["document", "code", "report", "config", "other"]
                }
              }
            }
          }
        },
        "required": ["id", "name", "order"]
      },
      "minItems": 1
    },
    "contracts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Contrats applicables a ce workflow"
    }
  },
  "required": ["name", "version", "description", "type", "phases"],
  "additionalProperties": false
}
