{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AKORIS Manifest Schema",
  "type": "object",
  "required": ["projectName", "projectId", "akorisVersion"],
  "properties": {
    "projectName": { "type": "string" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "akorisVersion": { "type": "string", "pattern": "^\\^?[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "profile": { "type": "string", "enum": ["lite", "standard", "critical"] },
    "registryPath": { "type": "string" },
    "createdAt": { "type": "string", "format": "date" },
    "updatedAt": { "type": "string", "format": "date" },
    "agents": { "type": "array", "items": { "type": "string" } },
    "defaultLanguage": { "type": "string", "enum": ["fr", "en"] },
    "domain": { "type": "string" },
    "repository": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "branch": { "type": "string" }
      }
    }
  }
}
