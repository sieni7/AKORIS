{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AKORIS Quality Gate Schema",
  "type": "object",
  "required": ["id", "name", "description", "severity", "criteria", "threshold"],
  "properties": {
    "id": { "type": "string", "pattern": "^QG-[A-Z]{3,15}$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "severity": { "type": "string", "enum": ["bloquante", "critique", "majeure", "mineure"] },
    "owner": { "type": "string" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "evaluator", "weight"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "evaluator": { "type": "string" },
          "params": { "type": "object" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "controls": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
