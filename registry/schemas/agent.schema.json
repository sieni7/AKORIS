{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AKORIS Agent Schema",
  "type": "object",
  "required": ["id", "name", "version", "domain", "criticity", "status", "mission"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{2}$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "domain": { "type": "string", "enum": ["CORE", "DEV", "QA", "EXP", "GOV"] },
    "criticity": { "type": "string", "enum": ["critique", "haute", "moyenne", "basse"] },
    "status": { "type": "string", "enum": ["active", "inactive", "deprecated", "draft"] },
    "mission": { "type": "string" },
    "responsibilities": { "type": "array", "items": { "type": "string" } },
    "limits": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": { "type": "string" },
          "type": { "type": "string", "enum": ["mandatory", "optional"] }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["can", "cannot"] }
        }
      }
    }
  }
}
