{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AKORIS ADR Schema",
  "type": "object",
  "required": ["id", "title", "status", "date", "context", "decision", "consequences"],
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
    "title": { "type": "string" },
    "status": { "type": "string", "enum": ["proposed", "approved", "rejected", "superseded", "deprecated"] },
    "date": { "type": "string", "format": "date" },
    "supersedes": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
    "context": { "type": "string" },
    "decision": { "type": "string" },
    "consequences": { "type": "string" },
    "alternatives": { "type": "array", "items": { "type": "string" } }
  }
}
