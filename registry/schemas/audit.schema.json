{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://akoris.dev/schemas/audit.schema.json",
  "title": "AuditReport",
  "description": "Schema de validation pour les rapports d'audit",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Titre du rapport d'audit"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date de realisation de l'audit"
    },
    "auditor": {
      "type": "string",
      "description": "Nom ou identifiant de l'auditeur"
    },
    "scope": {
      "type": "string",
      "description": "Perimetre de l'audit"
    },
    "reference": {
      "type": "string",
      "description": "Referentiel ou norme utilisee"
    },
    "version": {
      "type": "string",
      "description": "Version du perimetre audite"
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "compliance_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["total_findings", "compliance_rate"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "status": {
            "type": "string",
            "enum": ["open", "in_progress", "resolved", "accepted"]
          },
          "recommendation": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "required": ["id", "title", "severity", "status"]
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "action": { "type": "string" },
          "owner": { "type": "string" },
          "deadline": { "type": "string", "format": "date" }
        },
        "required": ["action", "priority"]
      }
    }
  },
  "required": ["title", "date", "auditor", "scope", "summary", "findings"],
  "additionalProperties": false
}
