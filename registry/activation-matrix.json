      "agents": ["CORE-02","CORE-04","DEV-02","DEV-03","DEV-04"],
      "frequency": "per-feature",
      "phase": "development"
    },
    "ARCHITECTURE_DECISION": {
      "description": "Prise de décision architecturale",
      "agents": ["CORE-02","CORE-04","DEV-01","DEV-02"],
      "frequency": "as-needed",
      "phase": "design"
    },
    "CODE_REVIEW": {
      "description": "Revue de code avant merge",
      "agents": ["QA-01"],
      "frequency": "per-pr",
      "phase": "quality"
    },
    "SECURITY_AUDIT": {
      "description": "Audit de sécurité avant release",
      "agents": ["QA-03"],
      "frequency": "pre-release",
      "phase": "quality"
    },
    "PERFORMANCE_AUDIT": {
      "description": "Audit de performance",
      "agents": ["QA-04","DEV-07"],
      "frequency": "pre-release",
      "phase": "quality"
    },
    "ACCESSIBILITY_AUDIT": {
      "description": "Audit d'accessibilité",
      "agents": ["QA-05"],
      "frequency": "pre-release",
      "phase": "quality"
    },
    "DOCUMENTATION_AUDIT": {
      "description": "Audit de documentation",
      "agents": ["QA-06","CORE-06"],
      "frequency": "pre-release",
      "phase": "quality"
    },
    "TECHNICAL_DEBT_REVIEW": {
      "description": "Revue de dette technique",
      "agents": ["QA-07"],
      "frequency": "per-sprint",
      "phase": "quality"
