{
  "version": "1.0.0",
  "events": {
    "PROJECT_INIT": {
      "description": "Initialisation d'un nouveau projet",
      "agents": ["CORE-01","CORE-02","GOV-01"],
      "frequency": "once",
      "phase": "initiation"
    },
