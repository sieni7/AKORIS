      "agents": ["GOV-03","CORE-06"],
      "frequency": "per-sprint",
      "phase": "improvement"
    },
    "KNOWLEDGE_CAPTURE": {
      "description": "Capitalisation des connaissances",
      "agents": ["GOV-03","EXP-07"],
      "frequency": "as-needed",
      "phase": "improvement"
    },
    "COMPLIANCE_AUDIT": {
      "description": "Audit de conformité réglementaire",
      "agents": ["EXP-05","CORE-05"],
      "frequency": "quarterly",
      "phase": "governance"
