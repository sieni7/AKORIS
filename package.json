{
  "name": "akoris",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @akoris/core build",
    "build:cli": "pnpm --filter @akoris/cli build",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @akoris/core test",
    "test:cli": "pnpm --filter @akoris/cli test",
    "dev": "pnpm -r dev",
    "validate:registry": "node scripts/validate-registry.js",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.5.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0"
  }
}
