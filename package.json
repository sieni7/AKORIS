{
  "name": "akoris",
  "version": "1.0.0",
  "private": true,
  "description": "Standard de gouvernance pour le développement logiciel assisté par intelligence artificielle",
  "author": "OULAÏ SIÉNI",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "pnpm build",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "cli": "node packages/cli/dist/index.js",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "docs": "typedoc --out docs/api packages/*/src",
    "dev:api": "pnpm --filter api dev",
    "dev:dashboard": "pnpm --filter dashboard dev",
    "build:api": "pnpm --filter api build",
    "build:dashboard": "pnpm --filter dashboard build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.0.0",
    "typescript": "5.7.3"
  }
}
