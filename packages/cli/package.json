{
  "name": "@akoris/cli",
  "version": "1.0.0",
  "description": "AKORIS CLI - Orchestrator for AI-assisted software governance",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "akoris": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@akoris/core": "workspace:*",
    "@akoris/shared": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.3.0",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/inquirer": "^9.0.7",
    "@types/semver": "^7.5.8",
    "typescript": "^5.0.0",
    "tsup": "^7.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0"
  }
}
